<Page
    x:Class="NokiDrome.UWP.Views.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundDeepBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundSurfaceBrush}" Padding="4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource IconButtonStyle}"
                    Content="&#xE72B;"
                    Click="OnBackClick" />
            <TextBlock Grid.Column="1"
                       Text="NOW PLAYING"
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,48,0" />
        </Grid>

        <!-- Album Art -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="CoverArtBorder"
                    Width="280" Height="280"
                    CornerRadius="8"
                    Background="{StaticResource BackgroundCardBrush}">
                <Image x:Name="CoverArtImage" Stretch="UniformToFill" />
            </Border>
        </Grid>

        <!-- Song Info -->
        <StackPanel Grid.Row="2" Padding="24,16,24,8">
            <TextBlock x:Name="TitleLabel"
                       Style="{StaticResource TitleTextStyle}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <TextBlock x:Name="ArtistLabel"
                       Style="{StaticResource SubtitleTextStyle}"
                       TextAlignment="Center"
                       Margin="0,4,0,0" />
            <TextBlock x:Name="AlbumLabel"
                       Style="{StaticResource CaptionTextStyle}"
                       TextAlignment="Center"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- Scrubber -->
        <Grid Grid.Row="3" Padding="16,0,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PositionLabel"
                       Grid.Column="0"
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />
            <Slider x:Name="ScrubSlider"
                    Grid.Column="1"
                    Minimum="0" Maximum="1"
                    Foreground="{StaticResource AccentBrush}"
                    VerticalAlignment="Center" />
            <TextBlock x:Name="DurationLabel"
                       Grid.Column="2"
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0" />
        </Grid>

        <!-- Main Transport Controls -->
        <Grid Grid.Row="4" HorizontalAlignment="Center" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PrevBtn"
                    Grid.Column="0"
                    Style="{StaticResource IconButtonStyle}"
                    Content="&#xE892;"
                    Click="OnPrevClick" />
            <Button x:Name="PlayPauseBtn"
                    Grid.Column="1"
                    Style="{StaticResource PlayButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="OnPlayPauseClick" />
            <Button x:Name="NextBtn"
                    Grid.Column="2"
                    Style="{StaticResource IconButtonStyle}"
                    Content="&#xE893;"
                    Click="OnNextClick" />
        </Grid>

        <!-- Secondary Controls: Shuffle / Star / Repeat -->
        <Grid Grid.Row="5" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ShuffleBtn"
                    Grid.Column="0"
                    Style="{StaticResource IconButtonStyle}"
                    Content="&#xE8B1;"
                    Click="OnShuffleClick" />
            <Button x:Name="StarBtn"
                    Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}"
                    Click="OnStarClick" />
            <Button x:Name="RepeatBtn"
                    Grid.Column="2"
                    Style="{StaticResource IconButtonStyle}"
                    Click="OnRepeatClick" />
        </Grid>

    </Grid>
</Page>
