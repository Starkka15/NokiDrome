<Page
    x:Class="NokiDrome.UWP.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundDeepBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundSurfaceBrush}" Padding="8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="QueryBox"
                     Style="{StaticResource DarkTextBoxStyle}"
                     PlaceholderText="Search songs, albums, artists…"
                     KeyDown="OnQueryKeyDown" />
            <Button Grid.Column="1" x:Name="SearchBtn"
                    Style="{StaticResource IconButtonStyle}"
                    Content="&#xE721;"
                    Margin="4,0,0,0"
                    Click="OnSearchClick" />
        </Grid>

        <!-- Results pivot -->
        <Pivot Grid.Row="1" x:Name="ResultsPivot"
               Background="{StaticResource BackgroundDeepBrush}"
               Foreground="{StaticResource TextPrimaryBrush}">

            <!-- Songs -->
            <PivotItem x:Name="SongsPivotItem" Header="Songs">
                <ListView x:Name="SongsList"
                          IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="OnSongClick"
                          Background="Transparent"
                          ItemContainerStyle="{StaticResource TransparentListItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,10,0,10"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ArtistName}"
                                                   Style="{StaticResource SubtitleTextStyle}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DurationText}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <!-- Albums -->
            <PivotItem x:Name="AlbumsPivotItem" Header="Albums">
                <ListView x:Name="AlbumsList"
                          IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="OnAlbumClick"
                          Background="Transparent"
                          ItemContainerStyle="{StaticResource TransparentListItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,10,0,10"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource BodyTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ArtistName}"
                                               Style="{StaticResource SubtitleTextStyle}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <!-- Artists -->
            <PivotItem x:Name="ArtistsPivotItem" Header="Artists">
                <ListView x:Name="ArtistsList"
                          IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="OnArtistClick"
                          Background="Transparent"
                          ItemContainerStyle="{StaticResource TransparentListItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,12,0,12"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource BodyTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

        </Pivot>

        <!-- Search progress overlay -->
        <ProgressRing x:Name="SearchProgress" Grid.Row="1" IsActive="False"
                      Width="40" Height="40"
                      Foreground="{StaticResource AccentBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
